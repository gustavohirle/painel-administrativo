// Schema do banco -- so entra aqui o que a Nuvemshop NAO sabe.
//
// Pedidos, clientes e produtos vendidos vem da API e nao sao replicados:
// replicar financeiro e criar duas versoes da verdade. O banco guarda apenas
// os nossos cadastros -- custo, comissao, imposto, composicao de kit, contagem
// de estoque e usuarios.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Ficha de custo de fabricacao de um produto ou variante da Nuvemshop.
model CustoProduto {
  id String @id @default(cuid())

  /// `product_id` da Nuvemshop. E a chave do vinculo com a venda.
  produtoId Int

  /// `variant_id` da Nuvemshop. NULL = o custo vale para todas as variantes.
  varianteId Int?

  /// SKU, para o dono conferir contra a planilha dele.
  sku  String?
  nome String

  custoMateriaPrima Decimal @db.Decimal(12, 2)
  custoEmbalagem    Decimal @db.Decimal(12, 2)
  custoMaoDeObra    Decimal @db.Decimal(12, 2)
  custoIndireto     Decimal @db.Decimal(12, 2)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // ATENCAO: no Postgres, NULLs sao distintos entre si num indice unico.
  // Ou seja, este @@unique NAO impede duas fichas de produto inteiro
  // (varianteId = NULL) para o mesmo produtoId. A unicidade desse caso e
  // garantida no repositorio, em `salvarCusto`.
  @@unique([produtoId, varianteId])
  @@index([produtoId])
}

/// Contrato de comissao de um influencer, vinculado a uma marca/loja.
model Influencer {
  id   String @id @default(cuid())
  nome String

  /// Casa com `Pedido.marca` (a loja Nuvemshop de origem).
  marca String

  /// Percentual do contrato, ex.: 30.00 para 30%.
  percentual Decimal @db.Decimal(5, 2)

  /// "bruto" | "recebido" | "receitaReal" -- ver `BaseComissao` em types/dominio.
  baseComissao String @default("bruto")

  /// Regime tributario DESTA marca. Cada influencer e uma operacao separada:
  /// uma marca pequena cabe no Simples, uma grande nao, e as duas convivem.
  regime       String  @default("simples_nacional")
  anexoSimples String  @default("II")
  uf           String  @default("GO")
  /// Receita de 12 meses informada a mao. NULL = calcular do historico.
  rbt12Manual  Decimal? @db.Decimal(14, 2)

  ativo      Boolean @default(true)
  observacao String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([marca])
  @@index([ativo])
}

/// Um tributo recolhido por fora da guia unica do Simples.
///
/// O que esta DENTRO do DAS nao e cadastrado: a reparticao vem da tabela
/// oficial do Anexo II. Cadastrar tambem faria o painel somar duas vezes.
model Imposto {
  id    String @id @default(cuid())
  nome  String
  sigla String

  /// "federal" | "estadual" | "municipal"
  esfera String

  /// "receita" | "lucro"
  baseIncidencia String @default("receita")

  /// Percentual, ex.: 19.00 para 19%.
  aliquota Decimal @db.Decimal(7, 4)

  /// Regimes em que este tributo incide. E o que faz o cadastro de produto se
  /// preencher sozinho a partir do regime do influencer dono.
  regimes String[] @default([])

  /// Presuncao de lucro, para tributos com baseIncidencia = "lucro".
  percentualPresuncao Decimal? @db.Decimal(6, 3)
  /// Valor deduzido da base por mes (adicional de IRPJ: R$ 20 mil).
  deducaoMensal       Decimal? @db.Decimal(14, 2)

  dentroDoDAS Boolean @default(false)

  /// Quando true, so incide sobre os produtos que marcaram este imposto.
  aplicacaoPorProduto Boolean @default(false)

  ativo Boolean @default(false)

  /// Comeca false. A tela avisa enquanto ninguem confirmou a aliquota.
  confirmadoPeloContador Boolean @default(false)

  observacao String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo])
}

/// Aliquota interna de ICMS de um estado -- e o que define o DIFAL.
///
/// Numa venda interestadual ao consumidor final, a diferenca entre esta
/// aliquota e a interestadual vai para o estado de destino.
model AliquotaEstado {
  /// Sigla do estado. E a chave: um registro por UF.
  uf   String @id
  nome String

  /// Aliquota interna modal, em percentual.
  aliquotaInterna Decimal @db.Decimal(6, 3)

  ativo Boolean @default(true)

  /// Comeca false. A tela avisa enquanto ninguem confirmou.
  confirmadoPeloContador Boolean @default(false)

  observacao String?

  atualizadoEm DateTime @updatedAt
}

/// Cadastro de produto: vinculo fiscal, composicao de kit e identidade.
model Produto {
  id String @id @default(cuid())

  /// "produtoId:varianteId" ou "produtoId:*". Chave unica do item.
  chave String @unique

  produtoId  Int
  varianteId Int?

  nome String
  sku  String?
  ncm  String?

  /// "nuvemshop" | "manual"
  origem String @default("nuvemshop")

  /// Influencer dono. Um produto pertence a UM influencer -- e dele que vem
  /// o regime tributario aplicado ao item.
  influencerId String?

  /// Ids dos impostos marcados no cadastro.
  impostosIds String[] @default([])

  /// A Nuvemshop entrega o kit como UM produto -- ela nao decompoe.
  /// A composicao abaixo e o que baixa o estoque dos componentes certos.
  ehKit Boolean @default(false)

  /// Array de { chave, nome, quantidade }.
  componentes Json @default("[]")

  ativo      Boolean @default(true)
  observacao String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([produtoId])
  @@index([ativo])
}

/// Uma contagem de estoque feita por alguem, numa data.
///
/// O banco guarda CONTAGENS, nao saldo. O saldo atual e sempre
/// `contagem - vendido desde a contagem` -- funcao pura, idempotente.
/// Saldo mutavel iria a zero sozinho a cada reprocessamento.
model ContagemEstoque {
  id    String @id @default(cuid())
  chave String
  nome  String

  quantidade Int

  /// Vendas anteriores a esta data sao ignoradas no saldo.
  dataContagem DateTime

  responsavel String?
  observacao  String?

  registradoEm DateTime @default(now())

  @@index([chave, dataContagem])
}

/// Usuario do painel.
model Usuario {
  id      String @id @default(cuid())
  nome    String
  /// Login, sempre em minusculas.
  usuario String @unique

  /// "dono" | "estoque"
  perfil String @default("estoque")

  ativo Boolean @default(true)

  /// scrypt. NUNCA sai do servidor.
  senhaHash String
  senhaSal  String

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo])
}
