# ---------------------------------------------------------------------------
# MODO DE OPERACAO
# ---------------------------------------------------------------------------
# "demo"  -> dados ficticios deterministicos, funciona 100% offline (padrao)
# "live"  -> le a API real da Nuvemshop e o banco Postgres
FONTE_DADOS=demo

# ---------------------------------------------------------------------------
# NUVEMSHOP (so necessario quando FONTE_DADOS=live)
# ---------------------------------------------------------------------------
# Obtidos ao criar o app em https://partners.nuvemshop.com.br
NUVEMSHOP_STORE_ID=
NUVEMSHOP_ACCESS_TOKEN=
# Identificacao exigida pela Nuvemshop no header User-Agent
NUVEMSHOP_USER_AGENT="Painel Administrativo (contato@exemplo.com.br)"

# ---------------------------------------------------------------------------
# SESSAO
# ---------------------------------------------------------------------------
# Assina o cookie de sessao. Sem assinatura, qualquer pessoa trocaria o proprio
# perfil para "dono" no cookie e veria o financeiro.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Em modo demonstracao ha um segredo fixo embutido -- NAO use em producao.
SESSAO_SECRET=

# ---------------------------------------------------------------------------
# EXPOSICAO SEM HTTPS
# ---------------------------------------------------------------------------
# Em producao o cookie de sessao e `Secure`, ou seja, o navegador so o guarda
# em https://. Servindo por HTTP puro, o login falha SEM erro visivel: a senha
# certa devolve a tela de login de novo.
#
# "1" derruba essa exigencia. So funciona com FONTE_DADOS=demo -- em live a
# variavel e ignorada, para nao sobreviver a virada de chave. Senha e sessao
# passam em texto claro; nao use com dados reais.
PERMITIR_HTTP_SEM_TLS=

# ---------------------------------------------------------------------------
# BANCO DE DADOS (so necessario quando FONTE_DADOS=live)
# ---------------------------------------------------------------------------
# Neon: https://console.neon.tech -> copie a connection string com pooling
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/painel?sslmode=require"
