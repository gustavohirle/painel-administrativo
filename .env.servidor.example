# Onde o painel roda em producao. Este arquivo e modelo; o .env.servidor com os
# dados reais NAO vai para o git (o repositorio e publico).
#
#   cp .env.servidor.example .env.servidor
#
# Usuario e endereco do servidor.
PAINEL_SSH=root@0.0.0.0
# Chave privada que abre o SSH. O padrao ja e este caminho.
PAINEL_CHAVE=~/.ssh/painel_battlehost
