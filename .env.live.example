# ---------------------------------------------------------------------------
# MODO COM DADOS REAIS -- modelo do .env.live (ver DADOS_REAIS.md)
#
# O .env.live NAO vai para o git. Ele e lido so pelos comandos ":live"
# (npm run start:live, nuvemshop:testar, db:seed:live...). O .env de sempre
# continua em FONTE_DADOS=demo, e a demonstracao segue intacta na porta 3000.
# ---------------------------------------------------------------------------

FONTE_DADOS=live

# ---------------------------------------------------------------------------
# NUVEMSHOP
# ---------------------------------------------------------------------------
# Uma loja por influencer: cada um tem a sua loja Nuvemshop e a sua chave.
# Um bloco por loja, numerado a partir de 1 (ate 20). Bloco com a chave em
# branco (ou COLE_A_CHAVE_AQUI) e ignorado: preencha quando a chave chegar.
#   MARCA     nome da loja no painel. E CHAVE: o contrato do influencer na aba
#             Influencers precisa usar exatamente este texto, com a mesma
#             grafia e acento. E por ele que o produto sabe de quem e.
#   STORE_ID  numero da loja na Nuvemshop (o "user_id" que vem com a chave)
#   TOKEN     a chave de acesso (nao expira). Sem aspas, sem espacos.
NUVEMSHOP_LOJA_1_MARCA=""
NUVEMSHOP_LOJA_1_STORE_ID=
NUVEMSHOP_LOJA_1_TOKEN=COLE_A_CHAVE_AQUI

NUVEMSHOP_LOJA_2_MARCA=""
NUVEMSHOP_LOJA_2_STORE_ID=
NUVEMSHOP_LOJA_2_TOKEN=COLE_A_CHAVE_AQUI

NUVEMSHOP_LOJA_3_MARCA=""
NUVEMSHOP_LOJA_3_STORE_ID=
NUVEMSHOP_LOJA_3_TOKEN=COLE_A_CHAVE_AQUI

NUVEMSHOP_LOJA_4_MARCA=""
NUVEMSHOP_LOJA_4_STORE_ID=
NUVEMSHOP_LOJA_4_TOKEN=COLE_A_CHAVE_AQUI

NUVEMSHOP_LOJA_5_MARCA=""
NUVEMSHOP_LOJA_5_STORE_ID=
NUVEMSHOP_LOJA_5_TOKEN=COLE_A_CHAVE_AQUI

# Tambem aceito, no lugar dos blocos (ou junto deles), uma linha JSON:
# NUVEMSHOP_LOJAS='[{"marca":"NOME DA MARCA","storeId":"0000000","accessToken":"..."}]'

# Exigido pela Nuvemshop: nome do aplicativo e um contato (e-mail ou site).
NUVEMSHOP_USER_AGENT="painel-de-relatrios (https://github.com/gustavohirle/painel-administrativo)"

# Opcionais.
# O padrao e a v1: a 2025-03 lista os pedidos SEM o valor do frete.
# NUVEMSHOP_API_URL=https://api.nuvemshop.com.br/v1
# NUVEMSHOP_MESES=13
# NUVEMSHOP_ATUALIZAR_MINUTOS=10

# So para `npm run nuvemshop:token`, se a chave vier por codigo de autorizacao.
# NUVEMSHOP_CLIENT_ID=
# NUVEMSHOP_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# MARKETPLACES (Shopee, TikTok Shop, Mercado Livre)
# ---------------------------------------------------------------------------
# A empresa tambem vende fora da Nuvemshop, e hoje isso esta FORA do painel
# inteiro -- estoque, RBT12 e lucro sao so da Nuvemshop (secao 9, Fase 4).
#
# Por enquanto isto e so o CADASTRO das credenciais: preencher os blocos nao
# faz o painel buscar nada. `npm run canais:conferir` diz o que foi lido.
#
# Um bloco por conta, numerado a partir de 1 (ate 20). Bloco intocado (sem
# TIPO e sem CHAVE) e ignorado; bloco pela metade e ERRO, para um campo
# esquecido nao virar uma conta que silenciosamente nao busca.
#
#   TIPO      shopee | tiktok | mercadolivre
#   MARCA     nome da marca no painel. E CHAVE: precisa ser exatamente o texto
#             do contrato na aba Influencers, com a mesma grafia e acento.
#             Hoje so a Tha Beauty vende nesses canais.
#   LOJA_ID   identificador da loja/vendedor dentro do marketplace
#   CHAVE     identificador do aplicativo (nao e segredo)
#   SEGREDO   segredo do aplicativo -- este NAO aparece em log nem em tela
#   TOKEN     token de acesso inicial, se voce ja tiver um (opcional)
#   REFRESH   token de renovacao inicial (opcional)
#
# Onde achar cada um, por canal:
#
#   | campo   | Shopee        | TikTok Shop  | Mercado Livre        |
#   |---------|---------------|--------------|----------------------|
#   | CHAVE   | partner_id    | app_key      | client_id (App ID)   |
#   | SEGREDO | partner_key   | app_secret   | client_secret        |
#   | LOJA_ID | shop_id       | shop_cipher  | seller_id (user id)  |
#
#   Shopee: Open Platform | TikTok: Partner Center | ML: Developers
#
# IMPORTANTE -- o TOKEN aqui e so o primeiro. Nos tres canais o token de acesso
# dura horas e o de renovacao e trocado a cada uso, entao o que vale em tempo
# de execucao fica em .live-data/tokens-canais.json (modo 600), que e o unico
# caminho gravavel do servico em producao. Este arquivo serve para a primeira
# autorizacao e para destravar uma conta cujo token guardado venceu.

CANAL_1_TIPO=
CANAL_1_MARCA="Tha Beauty"
CANAL_1_LOJA_ID=
CANAL_1_CHAVE=COLE_A_CHAVE_AQUI
CANAL_1_SEGREDO=COLE_A_CHAVE_AQUI
# CANAL_1_TOKEN=
# CANAL_1_REFRESH=

CANAL_2_TIPO=
CANAL_2_MARCA="Tha Beauty"
CANAL_2_LOJA_ID=
CANAL_2_CHAVE=COLE_A_CHAVE_AQUI
CANAL_2_SEGREDO=COLE_A_CHAVE_AQUI
# CANAL_2_TOKEN=
# CANAL_2_REFRESH=

CANAL_3_TIPO=
CANAL_3_MARCA="Tha Beauty"
CANAL_3_LOJA_ID=
CANAL_3_CHAVE=COLE_A_CHAVE_AQUI
CANAL_3_SEGREDO=COLE_A_CHAVE_AQUI
# CANAL_3_TOKEN=
# CANAL_3_REFRESH=

# ---------------------------------------------------------------------------
# BANCO (cadastros: contratos, custos, impostos, usuarios, ordens)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://painel:SENHA@127.0.0.1:5432/painel"

# ---------------------------------------------------------------------------
# ACESSO
# ---------------------------------------------------------------------------
# Segredo proprio, diferente do .env da demonstracao.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSAO_SECRET=

# Senhas dos usuarios criados por `npm run db:seed:live` (minimo 12 caracteres).
# As da demonstracao (dono123, estoque123) sao publicas e sao recusadas.
SENHA_DONO=
SENHA_ESTOQUE=
