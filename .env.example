# ---------------------------------------------------------------------------
# MODO DE OPERACAO
# ---------------------------------------------------------------------------
# "demo"  -> dados ficticios deterministicos, funciona 100% offline (padrao)
# "live"  -> le a API real da Nuvemshop e o banco Postgres
FONTE_DADOS=demo

# ---------------------------------------------------------------------------
# NUVEMSHOP (so necessario quando FONTE_DADOS=live)
# ---------------------------------------------------------------------------
# Obtidos ao criar o app em https://partners.nuvemshop.com.br
NUVEMSHOP_STORE_ID=
NUVEMSHOP_ACCESS_TOKEN=
# Identificacao exigida pela Nuvemshop no header User-Agent
NUVEMSHOP_USER_AGENT="Painel Administrativo (contato@exemplo.com.br)"

# ---------------------------------------------------------------------------
# BANCO DE DADOS (so necessario quando FONTE_DADOS=live)
# ---------------------------------------------------------------------------
# Neon: https://console.neon.tech -> copie a connection string com pooling
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/painel?sslmode=require"
